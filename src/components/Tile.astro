---
import { t } from '../i18n';
import CoverArt from './CoverArt.astro';
import { formatCardDate, formatCardDateISO } from '../lib/format';
import { postHref, type Post } from '../lib/posts';
import { postCover } from '../lib/covers';

interface Props {
  post: Post;
  /** 磁贴尺寸 */
  variant?: 'hero' | '2up' | '3up';
}

const { post, variant = '2up' } = Astro.props;
const { data } = post;
const href = postHref(post);
const cover = postCover(post);
const category = data.categories[0] ?? t.common.post;

const headlineSize = {
  hero: 'text-[32px] leading-[1.3] tracking-[0.004em]',
  '2up': 'text-[24px] leading-[1.4] tracking-[0.009em]',
  '3up': 'text-[19px] leading-[1.45] tracking-[0.012em]',
}[variant];

const pad = variant === 'hero' ? 'p-6 sm:p-8' : 'p-5 sm:p-6';
---

<a
  href={href}
  class:list={[
    'tile group h-full',
    variant === 'hero' ? 'tile--hero tile--1up' : variant === '2up' ? 'tile--2up' : 'tile--3up',
    variant === 'hero' ? '' : 'flex flex-col rounded-[24px]',
  ]}
>
  <div class="tile__media">
    {
      cover ? (
        <img
          src={cover.src}
          width={cover.width}
          height={cover.height}
          alt={data.coverAlt ?? data.title}
          loading={variant === 'hero' ? 'eager' : 'lazy'}
          class="size-full object-cover"
        />
      ) : (
        <CoverArt
          seed={post.id}
          tone={category}
          scale={variant === 'hero' ? 'hero' : 'wide'}
          glyph={data.title}
          alt=""
          class="size-full object-cover"
        />
      )
    }
  </div>

  <div class:list={['tile__body flex flex-1 flex-col justify-between gap-4 bg-canvas', pad]}>
    <div>
      <p class="eyebrow">{category}</p>
      <h3 class:list={['tile-headline mt-3 line-clamp-3', headlineSize]}>{data.title}</h3>
      {
        variant === '3up' && data.summary ? (
          <p class="mt-2 line-clamp-2 text-[14px] leading-[1.6] tracking-[0.01em] text-graphite">
            {data.summary}
          </p>
        ) : null
      }
    </div>

    <div class="flex items-end justify-between gap-4">
      <time class="tile-timestamp" datetime={formatCardDateISO(data.date)}>
        {formatCardDate(data.date)}
      </time>
      {
        data.tags.length ? (
          <span class="truncate text-[12px] tracking-[0.01em] text-slate">{data.tags[0]}</span>
        ) : null
      }
    </div>
  </div>
</a>
