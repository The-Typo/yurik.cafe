---
/** 兜底路由：渲染 src/content/pages 下的 Markdown */
import { t } from '../i18n';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, navDescription } from '../lib/site';
import { formatDate } from '../lib/format';
import { getFriends } from '../lib/friends';

export const getStaticPaths = (async () => {
  // getStaticPaths 被提升，辅助函数须定义在内部
  const routePath = (entry: { id: string; data: { path?: string | null } }): string => {
    const declared = entry.data.path?.trim();
    if (declared) return declared.replace(/^\/+|\/+$/g, '');

    return entry.id
      .replace(/\\/g, '/')
      .replace(/\.mdx?$/, '')
      .replace(/(?:^|\/)index$/, '')
      .replace(/^\/+|\/+$/g, '');
  };

  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages.map((entry) => ({
    params: { path: routePath(entry) },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const friends = data.friends?.show ? await getFriends() : [];

const isRoot = !data.path || data.path === '/';
---

<BaseLayout
  title={data.title}
  description={data.description ?? navDescription(data.path ?? Astro.url.pathname) ?? site.description}
  keywords={data.tags?.join(',')}
>
  <section class="shell pt-14 pb-16 sm:pt-20">
    <div class="mx-auto max-w-[700px]">
    <p class="eyebrow">{isRoot ? t.page.about : t.page.page}</p>
    <h1
      class="mt-3 font-display text-[32px] leading-[1.3] font-bold tracking-[0.01em] text-ink sm:text-[44px] sm:leading-[1.25]"
    >
      {data.title}
    </h1>

    {
      data.date ? (
        <p class="mt-3 text-[13px] text-slate">
          <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
        </p>
      ) : null
    }

    {
      friends.length ? (
        <div class="mt-10">
          <h2 class="mb-4 text-[19px] font-semibold tracking-[0.01em] text-ink">
            {data.friends?.listTitle ?? 'Friends'}
          </h2>
          <ul class="friend-list">
            {friends.map((friend) => (
              <li>
                <a
                  href={friend.link}
                  class="friend-card"
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                >
                  <img
                    class="friend-avatar"
                    src={friend.avatar}
                    alt=""
                    loading="lazy"
                    width="48"
                    height="48"
                    referrerpolicy="no-referrer"
                  />
                  <span class="min-w-0">
                    <span class="friend-title">{friend.title}</span>
                    <span class="friend-desc">{friend.description}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : null
    }

    <div class="prose-newsroom mt-10">
      <Content />
    </div>
    </div>
  </section>
</BaseLayout>

<style>
  .friend-list {
    display: grid;
    gap: 12px;
    grid-template-columns: minmax(0, 1fr);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 735px) {
    .friend-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .friend-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 16px;
    background-color: var(--color-fog);
    text-decoration: none;
    transition: background-color 0.2s ease;
    height: 100%;
  }

  .friend-card:hover {
    background-color: var(--color-chip);
  }

  .friend-avatar {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    object-fit: cover;
    background-color: var(--color-chip);
  }

  .friend-title {
    display: block;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.4;
  }

  .friend-desc {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-graphite);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
