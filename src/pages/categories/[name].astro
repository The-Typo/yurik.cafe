---
import { t } from '../../i18n';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tile from '../../components/Tile.astro';
import { categoryDescriptions, site } from '../../lib/site';
import { sortPosts } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const names = new Set<string>();
  for (const post of posts) {
    for (const name of post.data.categories) names.add(name);
  }
  return [...names].map((name) => ({
    params: { name },
    props: { name },
  }));
}) satisfies GetStaticPaths;

const { name } = Astro.props;
const posts = sortPosts(
  await getCollection('posts', ({ data }) => !data.draft && data.categories.includes(name))
);
---

<BaseLayout
  title={t.taxonomyDetail.categoryTitle(name)}
  description={categoryDescriptions[name] ?? t.taxonomyDetail.categoryDescription(name)}
>
  <section class="shell pt-14 pb-12 sm:pt-20">
    <nav class="mb-6 flex items-center gap-2 text-[13px] text-slate" aria-label={t.post.breadcrumb}>
      <a href="/" class="transition-colors hover:text-link">{t.common.backHome}</a>
      <span aria-hidden="true">/</span>
      <a href="/categories/" class="transition-colors hover:text-link">{t.taxonomy.category}</a>
    </nav>

    <p class="eyebrow">{t.taxonomy.category}</p>
    <h1
      class="mt-3 font-display text-[36px] leading-[1.25] font-bold tracking-[0.01em] text-ink sm:text-[52px] sm:leading-[1.2]"
    >
      {name}
    </h1>
    <p class="mt-5 text-[18px] leading-[1.7] text-graphite">
      {categoryDescriptions[name] ?? t.taxonomyDetail.noDescription}
      <span class="text-slate">·</span>
      {t.taxonomy.postCount(posts.length)}
    </p>
  </section>

  <section class="bg-fog py-14">
    <div class="shell">
      {
        posts.length ? (
          <ul class="tile-grid">
            {posts.map((post, index) => (
              <li class="tile-item">
                <Tile post={post} variant={index === 0 ? 'hero' : '3up'} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-[17px] text-graphite">{t.taxonomyDetail.emptyPosts}</p>
        )
      }
    </div>
  </section>
</BaseLayout>
