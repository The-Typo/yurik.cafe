---
import { t } from '../../i18n';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tile from '../../components/Tile.astro';
import { categoryHref, categoryDescriptions } from '../../lib/site';
import { getAllPosts, collectCategories } from '../../lib/posts';

const posts = await getAllPosts();
const categories = collectCategories(posts);
---

<BaseLayout title={t.taxonomy.categoriesTitle} description={t.taxonomy.categoriesDescription}>
  <section class="shell pt-14 pb-12 sm:pt-20">
    <p class="eyebrow">{t.taxonomy.categoriesTitle}</p>
    <h1
      class="mt-3 font-display text-[36px] leading-[1.25] font-bold tracking-[0.01em] text-ink sm:text-[52px] sm:leading-[1.2]"
    >
      {t.taxonomy.categoriesTitle}
    </h1>
    <p class="mt-5 text-[18px] leading-[1.7] text-graphite">
      {t.taxonomy.postCount(posts.length)}
    </p>
  </section>

  <section class="shell pb-24">
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        categories.map((category) => (
          <li>
            <a
              href={categoryHref(category.name)}
              class="group flex items-center justify-between gap-4 rounded-[20px] bg-fog px-6 py-5 transition-colors hover:bg-chip"
            >
              <div class="min-w-0">
                <p class="text-[19px] font-semibold text-ink transition-colors group-hover:text-link">
                  {category.name}
                </p>
                <p class="mt-1 text-[14px] text-graphite">
                  {categoryDescriptions[category.name] ?? t.taxonomyDetail.noDescription}
                </p>
              </div>
              <span class="flex-none text-[14px] tabular-nums text-slate">{category.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
