<header class="page-header">
  
  <h1 class="page-header__title"><%= page.title || __('archive.title') %></h1>

  <p class="page-header__subtitle"><%= page.subtitle || __('archive.subtitle') %></p>

</header>

<main class="content-container content-container--wide">
  <% var posts = page.posts || []; %>
  <% if (posts.data) posts = posts.data; %>
  <% if (posts.toArray) posts = posts.toArray(); %>
  <% 
    var years = {};
    posts.forEach(function(post) {
      var y = post.date.year();
      if (!years[y]) years[y] = [];
      years[y].push(post);
    });
    var yearKeys = Object.keys(years).sort().reverse();
  %>
  <% yearKeys.forEach(function(year) { %>
  <section class="archive-year reveal">
    <h2 class="archive-year__heading"><%= year %></h2>
    <ul class="archive-list">
      <% years[year].sort(function(a, b) { return b.date - a.date; }).forEach(function(post) { %>
      <li class="archive-list__item">
        <time class="archive-list__date" datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'MM-DD') %></time>
        <span class="archive-list__title"><a href="<%= url_for(post.path) %>"><%= post.title %></a></span>
      </li>
      <% }); %>
    </ul>
  </section>
  <% }); %>
</main>
