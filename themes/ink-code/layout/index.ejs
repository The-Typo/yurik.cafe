<% if (theme.hero && theme.hero.enabled && page.current === 1) { %>
  <%- partial('_partial/hero') %>
<% } else if(page.current === 1) { %>
  <header class="page-header">
    <h1 class="page-header__title"><%= config.title %></h1>
    <p class="page-header__subtitle"><%= config.subtitle %></p>
  </header>
<% } %>

<main class="content-container content-container--wide">
  <div class="home-grid">
    <%- partial('_partial/card-grid', { posts: page.posts }) %>
  </div>

  <% if (page.total > 1) { %>
  <nav class="pagination">
    <%- paginator({
      prev_text: __('paginator.prev'),
      next_text: __('paginator.next'),
      escape: false
    }) %>
  </nav>
  <% } else { %>
  <div style="text-align: center; margin-top: var(--space-4xl);">
    <a href="<%= url_for('/archives/') %>" class="btn btn--outline btn--lg"><%= __('index.browse_all') %></a>
  </div>
  <% } %>
</main>
