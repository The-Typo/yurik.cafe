<header class="page-header">
  <h1 class="page-header__title"><%= page.tag %></h1>
  <p class="page-header__subtitle"><%= page.posts.length %><%= __('post.posts_count') %></p>
</header>

<main class="content-container content-container--wide">
  <div class="home-grid">
    <%- partial('_partial/card-grid', { posts: page.posts }) %>
  </div>
</main>
