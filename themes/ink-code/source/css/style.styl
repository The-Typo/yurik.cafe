// ============================================================
// "一本会写代码的杂志" — Design System
// Elegant Editorial × Code-Friendly Blog
// ============================================================

// ----- Fonts (Google Fonts) -----
@import url('./fonts.css')

// ----- CSS Custom Properties (Design Tokens) -----
:root
  // === Color System (oklch) ===

  // Backgrounds
  --color-bg:             oklch(0.985 0.003 85)
  --color-surface:        oklch(0.965 0.006 80)
  --color-surface-hover:  oklch(0.95 0.008 80)

  // Text
  --color-text-primary:   oklch(0.22 0.02 85)
  --color-text-secondary: oklch(0.48 0.01 80)
  --color-text-muted:     oklch(0.6 0.01 80)

  // Accent
  --color-accent:         oklch(0.62 0.16 75)
  --color-accent-hover:   oklch(0.55 0.17 72)
  --color-accent-subtle:  oklch(0.92 0.04 80)

  // Borders & Dividers
  --color-border:         oklch(0.88 0.01 80)
  --color-border-strong:  oklch(0.78 0.02 80)

  // Code
  --color-code-bg:        oklch(0.18 0.01 265)
  --color-code-text:      oklch(0.88 0.005 85)
  --color-code-inline-bg: oklch(0.93 0.015 80)

  // Tags
  --color-tag-bg:         oklch(0.92 0.02 80)
  --color-tag-text:       oklch(0.48 0.02 75)

  // === Typography ===
  --font-display:    'Newsreader', 'Noto Serif SC', 'Georgia', 'Times New Roman', 'Source Han Serif SC', 'STSong', 'Songti SC', serif
  --font-body:       'Outfit', 'Noto Sans SC', 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif
  --font-ui:         'Plus Jakarta Sans', 'Noto Sans SC', 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif
  --font-mono:       'JetBrains Mono', 'Fira Code', 'Consolas', 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', monospace

  // === Type Scale (Major Third, base 18px) ===
  --text-xs:    clamp(0.625rem, 1.5vw, 0.7rem)
  --text-sm:    clamp(0.75rem, 1.5vw, 0.833rem)
  --text-base:  clamp(0.95rem, 2vw, 1.063rem)
  --text-lg:    clamp(1.1rem, 2.5vw, 1.25rem)
  --text-xl:    clamp(1.3rem, 3vw, 1.5rem)
  --text-2xl:   clamp(1.6rem, 3.5vw, 1.875rem)
  --text-3xl:   clamp(2rem, 4vw, 2.375rem)
  --text-4xl:   clamp(2.4rem, 5vw, 3rem)
  --text-5xl:   clamp(3rem, 6vw, 3.75rem)

  // === Spacing Scale (8px grid) ===
  --space-4xs:  0.25rem
  --space-3xs:  0.375rem
  --space-2xs:  0.5rem
  --space-xs:   0.75rem
  --space-sm:   1rem
  --space-md:   1.25rem
  --space-lg:   1.5rem
  --space-xl:   2rem
  --space-2xl:  2.5rem
  --space-3xl:  3rem
  --space-4xl:  4rem
  --space-5xl:  5rem
  --space-6xl:  6rem
  --space-7xl:  7.5rem
  --space-8xl:  10rem

  // === Layout ===
  --content-width:    65rem
  --content-wide:     75rem
  --content-gap:      1.5rem
  --radius-sm:        4px
  --radius-md:        8px
  --radius-lg:        12px

  // === Shadows ===
  --shadow-card:      0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04)
  --shadow-card-hover: 0 2px 8px rgba(0,0,0,0.06), 0 1px 3px rgba(0,0,0,0.03)

  // === Motion ===
  --ease-out:         cubic-bezier(0.16, 1, 0.3, 1)
  --ease-in-out:      cubic-bezier(0.65, 0, 0.35, 1)
  --duration-fast:    150ms
  --duration-normal:  250ms
  --duration-slow:    400ms

  --card-height:      14rem

// ----- Reset & Base -----
*
*::before
*::after
  margin: 0
  padding: 0
  box-sizing: border-box

html
  font-size: 100%
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale
  text-rendering: optimizeLegibility
  scroll-behavior: smooth

body
  font-family: var(--font-body)
  font-size: var(--text-base)
  line-height: 1.75
  color: var(--color-text-primary)
  background-color: var(--color-bg)

// ----- Typography -----
h1
h2
h3
h4
h5
h6
  font-family: var(--font-display)
  line-height: 1.2
  font-weight: 500
  color: var(--color-text-primary)
  margin-top: var(--space-lg)

h1
  font-size: var(--text-4xl)
  letter-spacing: -0.02em
h2
  font-size: var(--text-3xl)
  letter-spacing: -0.015em
h3
  font-size: var(--text-2xl)
  letter-spacing: -0.01em
h4
  font-size: var(--text-xl)
h5
  font-size: var(--text-lg)
h6
  font-size: var(--text-base)
  font-weight: 600

p
  margin-top: var(--space-lg)

a
  color: var(--color-accent)
  text-decoration: none
  transition: color var(--duration-fast) var(--ease-out)

  &:hover
    color: var(--color-accent-hover)

// ----- Images -----
img
  max-width: 100%
  height: auto
  display: block

// ----- Selection -----
::selection
  background: var(--color-accent-subtle)
  color: var(--color-text-primary)

// ============================================================
// COMPONENTS — Navigation
// ============================================================
.site-nav
  z-index: 100
  width: 100%

  &__inner
    display: flex
    align-items: center
    justify-content: space-between
    width: 100%
    max-width: var(--content-wide)
    margin: 0 auto
    padding: var(--space-lg) var(--space-2xl)

  &__brand
    font-family: var(--font-display)
    font-size: var(--text-xl)
    font-weight: 500
    text-decoration: none
    letter-spacing: -0.02em
    transition: color var(--duration-fast) var(--ease-out)
    line-height: 1

  &__links
    display: flex
    gap: var(--space-lg)
    list-style: none
    align-items: center
    margin: 0

    a
      display: inline-flex
      align-items: center
      font-family: var(--font-ui)
      font-size: var(--text-sm)
      font-weight: 500
      line-height: 1
      letter-spacing: 0.01em
      transition: color var(--duration-fast) var(--ease-out)
      text-decoration: none

  // ---- Mode A: Hero pages ----
  body:has(.hero) &
    position: absolute
    top: 0
    left: 0
    background: transparent

  body:has(.hero) &__brand
    color: oklch(0.92 0.005 85)
    &:hover
      color: oklch(0.97 0.005 85)

  body:has(.hero) &__links a
    color: oklch(0.82 0.005 85)
    &:hover
    &.active
      color: oklch(0.97 0.005 85)

  // ---- Mode B: Non-hero pages ----
  body:not(:has(.hero)) &
    position: relative
    background: var(--color-surface)
    border-bottom: 1px solid var(--color-border)

  body:not(:has(.hero)) &__brand
    color: var(--color-text-primary)
    &:hover
      color: var(--color-accent)

  body:not(:has(.hero)) &__links a
    color: var(--color-text-secondary)
    &:hover
    &.active
      color: var(--color-accent)

  // ---- Mobile nav responsive ----
  @media (max-width: 640px)
    &__links
      position: fixed
      top: 0
      right: -100%
      width: 75vw
      max-width: 320px
      height: 100vh
      flex-direction: column
      background: var(--color-bg)
      padding: var(--space-5xl) var(--space-2xl)
      gap: var(--space-xl)
      transition: right var(--duration-normal) var(--ease-out)
      box-shadow: -4px 0 24px rgba(0,0,0,0.08)
      z-index: 200

      &.open
        right: 0

      a
        font-size: var(--text-lg)

// ----- Mobile Nav Toggle -----
.nav-toggle
  display: none
  background: none
  border: none
  cursor: pointer
  padding: var(--space-xs)

  span
    display: block
    width: 22px
    height: 2px
    background: var(--color-text-primary)
    margin: 5px 0
    transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out)

  body:has(.hero) & span
    background: oklch(0.92 0.005 85)

  @media (max-width: 640px)
    display: block

// ----- Nav Overlay (mobile) -----
.nav-overlay
  position: fixed
  inset: 0
  background: oklch(0% 0 0 / 30%)
  z-index: 99
  opacity: 0
  visibility: hidden
  transition: opacity var(--duration-normal) var(--ease-out),
              visibility var(--duration-normal) var(--ease-out)

  &.open
    opacity: 1
    visibility: visible

// ============================================================
// COMPONENTS — Footer
// ============================================================
.site-footer
  border-top: 1px solid var(--color-border)
  padding: var(--space-4xl) var(--space-2xl) var(--space-2xl)
  margin-top: var(--space-6xl)
  text-align: center

  &__inner
    max-width: var(--content-wide)
    margin: 0 auto

  &__text
    font-family: var(--font-ui)
    font-size: var(--text-sm)
    color: var(--color-text-muted)

  &__links
    display: flex
    justify-content: center
    gap: var(--space-lg)
    list-style: none
    margin-bottom: var(--space-xl)

    a
      font-family: var(--font-ui)
      font-size: var(--text-sm)
      color: var(--color-text-secondary)

      &:hover
        color: var(--color-accent)

// ============================================================
// COMPONENTS — Card (Article Card)
// ============================================================
.card
  display: flex
  align-items: stretch
  background: var(--color-bg)
  border: 1px solid var(--color-border)
  border-radius: var(--radius-md)
  text-decoration: none
  color: inherit
  cursor: pointer
  height: var(--card-height)

  &:hover
    transform: translateY(-4px)
    box-shadow: var(--shadow-card-hover)

    .card__title
      color: var(--color-accent)

    .card__image
      transform: scale(1.06)

  &__body
    flex-shrink: 0
    width: 340px
    border-radius: 0 var(--radius-md) var(--radius-md) 0
    overflow: hidden

  &__image
    width: 100%
    height: 100%
    object-fit: cover
    display: block
    background: var(--color-surface)
    transition: transform var(--duration-slow) var(--ease-out)

  &__content
    flex: 1
    display: flex
    flex-direction: column
    padding: var(--space-lg) var(--space-xl)
    min-width: 0
    overflow: hidden
    

  &__date
    font-family: var(--font-ui)
    font-size: var(--text-xs)
    color: var(--color-text-muted)
    text-transform: uppercase
    letter-spacing: 0.06em
    margin: 0 0 var(--space-xs)

  &__title
    font-family: var(--font-display)
    font-size: var(--text-xl)
    font-weight: 500
    line-height: 1.25
    margin: 0 0 var(--space-xs)
    color: var(--color-text-primary)
    transition: color var(--duration-fast) var(--ease-out)
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis
    flex-shrink: 0

  &__excerpt
    font-size: var(--text-sm)
    color: var(--color-text-secondary)
    line-height: 1.7
    margin: 0 0 var(--space-sm)
    display: -webkit-box
    -webkit-line-clamp: 3
    -webkit-box-orient: vertical
    overflow: hidden

  &__meta
    display: flex
    align-items: center
    gap: var(--space-sm)
    flex-wrap: nowrap
    overflow: hidden
    margin: auto 0 0

  // No-image cards
  &--no-image
    height: var(--card-height)
    padding: var(--space-xl)

    .card__body
      display: none

    .card__content
      padding: 0

  @media (max-width: 640px)
    flex-direction: column
    height: auto

    .card__title
      white-space: normal

    &__body
      width: 100%
      height: 200px
      border-radius: var(--radius-md) var(--radius-md) 0 0
      order: -1

    .home-grid__hero & &__body
      width: 100%
      height: 220px

// ============================================================
// COMPONENTS — Tag
// ============================================================
.tag
  display: inline-block
  font-family: var(--font-ui)
  font-size: var(--text-xs)
  font-weight: 500
  color: var(--color-tag-text)
  background: var(--color-tag-bg)
  padding: var(--space-3xs) var(--space-sm)
  border-radius: 999px
  letter-spacing: 0.02em
  transition: background var(--duration-fast) var(--ease-out),
              color var(--duration-fast) var(--ease-out)
  text-decoration: none

a.tag:hover
  background: var(--color-accent-subtle)
  color: var(--color-accent-hover)

// ============================================================
// COMPONENTS — Button
// ============================================================
.btn
  display: inline-flex
  align-items: center
  gap: var(--space-xs)
  font-family: var(--font-ui)
  font-size: var(--text-sm)
  font-weight: 600
  padding: var(--space-sm) var(--space-xl)
  border-radius: var(--radius-sm)
  border: none
  cursor: pointer
  transition: background var(--duration-fast) var(--ease-out),
              color var(--duration-fast) var(--ease-out),
              transform var(--duration-fast) var(--ease-out)
  letter-spacing: 0.01em
  text-decoration: none

  &:active
    transform: scale(0.97)

  // Primary
  &--primary
    background: var(--color-accent)
    color: var(--color-bg)
    &:hover
      background: var(--color-accent-hover)
      color: var(--color-bg)

  // Secondary / Outline
  &--outline
    background: transparent
    color: var(--color-accent)
    border: 1.5px solid var(--color-accent)
    &:hover
      background: var(--color-accent-subtle)
      color: var(--color-accent-hover)
      border-color: var(--color-accent-hover)

  // Ghost
  &--ghost
    background: transparent
    color: var(--color-text-secondary)
    &:hover
      background: var(--color-surface)
      color: var(--color-text-primary)

  // Sizes
  &--sm
    padding: var(--space-2xs) var(--space-md)
    font-size: var(--text-xs)

  &--lg
    padding: var(--space-md) var(--space-2xl)
    font-size: var(--text-base)

// ============================================================
// COMPONENTS — Badge
// ============================================================
.badge
  display: inline-flex
  align-items: center
  font-family: var(--font-ui)
  font-size: var(--text-xs)
  font-weight: 600
  padding: var(--space-4xs) var(--space-sm)
  border-radius: 999px
  background: var(--color-accent-subtle)
  color: var(--color-accent-hover)
  letter-spacing: 0.02em

// ============================================================
// COMPONENTS — Divider
// ============================================================
.divider
  border: none
  height: 1px
  background: var(--color-border)
  margin: var(--space-4xl) 0

  &--short
    width: 4rem
    margin-left: 0
    margin-right: 0

  &--ornament
    display: flex
    align-items: center
    gap: var(--space-md)
    color: var(--color-text-muted)
    font-size: var(--text-xs)
    letter-spacing: 0.1em

    &::before
    &::after
      content: ''
      flex: 1
      height: 1px
      background: var(--color-border)

// ============================================================
// MARKDOWN ELEMENTS — Code  →  @import '_highlight'
// ============================================================
@import '_highlight'

// ============================================================
// MARKDOWN ELEMENTS — Blockquote
// ============================================================
blockquote
  font-family: var(--font-display)
  font-style: italic
  font-size: var(--text-lg)
  color: var(--color-text-secondary)
  padding: var(--space-lg) var(--space-xl)
  margin: var(--space-2xl) 0
  border-left: 3px solid var(--color-accent)
  background: var(--color-surface)
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0

  p:last-child
    margin-bottom: 0
    margin-top: 0

  cite
    display: block
    font-family: var(--font-ui)
    font-style: normal
    font-size: var(--text-sm)
    color: var(--color-text-muted)
    margin-top: var(--space-sm)

// ============================================================
// MARKDOWN ELEMENTS — Table
// ============================================================
table
  width: 100%
  border-collapse: collapse
  margin: var(--space-xl) 0
  font-size: var(--text-sm)

thead th
  font-family: var(--font-ui)
  font-weight: 600
  text-align: left
  padding: var(--space-sm) var(--space-md)
  border-bottom: 2px solid var(--color-border-strong)
  color: var(--color-text-primary)

tbody
  td
    padding: var(--space-sm) var(--space-md)
    border-bottom: 1px solid var(--color-border)
    color: var(--color-text-secondary)

// ============================================================
// MARKDOWN ELEMENTS — Lists
// ============================================================
ul
ol
  padding-left: var(--space-xl)
  margin-bottom: var(--space-lg)

li
  margin-bottom: var(--space-xs)

  > ul
  > ol
    margin-top: var(--space-xs)
    margin-bottom: 0

// Task list
.task-list
  list-style: none
  padding-left: 0

.task-list-item
  display: flex
  align-items: flex-start
  gap: var(--space-sm)

  input[type="checkbox"]
    margin-top: 0.35em
    accent-color: var(--color-accent)

// ============================================================
// MARKDOWN ELEMENTS — Horizontal Rule
// ============================================================
hr
  border: none
  height: 1px
  background: var(--color-border)
  margin: var(--space-3xl) 0

// ============================================================
// MARKDOWN ELEMENTS — Footnotes
// ============================================================
.footnote-ref
  font-size: 0.75em
  vertical-align: super
  line-height: 0

.footnotes
  margin-top: var(--space-4xl)
  padding-top: var(--space-xl)
  border-top: 1px solid var(--color-border)
  font-size: var(--text-sm)

// ============================================================
// MARKDOWN ELEMENTS — Details / Summary
// ============================================================
details
  margin: var(--space-lg) 0
  padding: var(--space-md) var(--space-lg)
  background: var(--color-surface)
  border-radius: var(--radius-md)
  border: 1px solid var(--color-border)

summary
  font-family: var(--font-ui)
  font-weight: 600
  font-size: var(--text-sm)
  cursor: pointer
  color: var(--color-text-primary)

details[open] summary
  margin-bottom: var(--space-md)

// ============================================================
// MARKDOWN ELEMENTS — Image figure
// ============================================================
figure
  margin: var(--space-2xl) 0

  img
    width: 100%
    border-radius: var(--radius-md)
    background: var(--color-surface)

figcaption
  font-family: var(--font-ui)
  font-size: var(--text-sm)
  color: var(--color-text-muted)
  text-align: center
  margin-top: var(--space-sm)

.article-body img
  width: 100%
  border-radius: var(--radius-md)
  margin: var(--space-2xl) 0
  background: var(--color-surface)

  &:first-child
    margin-top: 0

// ============================================================
// MARKDOWN ELEMENTS — Abbreviation
// ============================================================
abbr[title]
  text-decoration: underline dotted
  text-underline-offset: 0.2em
  cursor: help

// ============================================================
// MARKDOWN ELEMENTS — Mark / Highlight
// ============================================================
mark
  background: var(--color-accent-subtle)
  color: var(--color-text-primary)
  padding: 0.1em 0.2em
  border-radius: 2px

// ============================================================
// LAYOUT — Content Container
// ============================================================
.content-container
  max-width: var(--content-width)
  margin: 0 auto
  padding: 0 var(--space-2xl)

  &--wide
    max-width: var(--content-wide)

// ============================================================
// LAYOUT — Page Header
// ============================================================
.page-header
  padding: var(--space-5xl) 0 var(--space-3xl)
  text-align: center

  &__title
    font-size: var(--text-4xl)
    margin-bottom: var(--space-sm)

  &__subtitle
    font-family: var(--font-body)
    font-size: var(--text-lg)
    color: var(--color-text-secondary)
    max-width: 36rem
    margin: 0 auto

// ============================================================
// HERO — Full-screen Background Image + Bottom-Left Title
// ============================================================
.hero
  position: relative
  min-height: 100vh
  display: flex
  flex-direction: column
  align-items: flex-start
  justify-content: flex-end
  text-align: left
  padding: var(--space-6xl) var(--space-4xl)
  overflow: hidden
  background-color: var(--color-surface)
  background-size: cover
  background-position: center
  background-repeat: no-repeat

  &::before
    content: ''
    position: absolute
    inset: 0
    background:
      linear-gradient(
        170deg,
        oklch(0% 0 0 / 15%) 0%,
        oklch(0% 0 0 / 2%) 35%,
        oklch(0% 0 0 / 0%) 55%,
        oklch(0% 0 0 / 55%) 85%,
        oklch(0% 0 0 / 70%) 100%
      )
    z-index: 1
    pointer-events: none

  &::after
    content: ''
    position: absolute
    inset: 0
    background:
      linear-gradient(
        to right,
        oklch(0% 0 0 / 35%) 0%,
        oklch(0% 0 0 / 8%) 40%,
        oklch(0% 0 0 / 0%) 70%
      )
    z-index: 2
    pointer-events: none

  &__content
    position: relative
    z-index: 3
    max-width: 42rem

  &__issue
    font-family: var(--font-ui)
    font-size: var(--text-xs)
    text-transform: uppercase
    letter-spacing: 0.15em
    color: oklch(0.9 0.01 80)
    margin-bottom: var(--space-md)
    opacity: 0.8

  &__title
    font-family: var(--font-display)
    font-size: clamp(2.5rem, 6vw, 5rem)
    font-weight: 400
    line-height: 1.08
    letter-spacing: -0.025em
    color: oklch(0.97 0.002 85)
    margin-bottom: var(--space-lg)

  &__title-line
    display: block

    &:first-child
      font-style: italic
      font-weight: 350

    &:last-child
      font-weight: 500

  &__subtitle
    font-family: var(--font-body)
    font-size: var(--text-base)
    color: oklch(0.82 0.006 85)
    margin-bottom: var(--space-2xl)
    line-height: 1.7
    max-width: 30rem

  &__actions
    display: flex
    gap: var(--space-md)
    flex-wrap: wrap

  &__scroll-hint
    position: absolute
    bottom: var(--space-2xl)
    right: var(--space-3xl)
    font-family: var(--font-ui)
    font-size: var(--text-xs)
    color: oklch(0.75 0.01 80)
    letter-spacing: 0.08em
    text-transform: uppercase
    display: flex
    flex-direction: column
    align-items: flex-end
    gap: var(--space-xs)
    animation: hero-float 2.5s ease-in-out infinite
    z-index: 3

    &::after
      content: ''
      width: 1px
      height: 2rem
      background: oklch(0.7 0.01 80)

  @keyframes hero-float
    0%, 100%
      transform: translateY(0)
    50%
      transform: translateY(6px)

  .hero__line
    opacity: 0
    transform: translateY(32px)
    animation: hero-fade-up 0.8s var(--ease-out) forwards

  @keyframes hero-fade-up
    0%
      opacity: 0
      transform: translateY(32px)
    100%
      opacity: 1
      transform: translateY(0)

  @media (max-width: 640px)
    padding: var(--space-4xl) var(--space-xl)

    &__title
      font-size: clamp(2rem, 8vw, 3.5rem)

    &__subtitle
      font-size: var(--text-sm)
      margin-bottom: 0

    &__scroll-hint
      right: var(--space-xl)
      bottom: var(--space-xl)

// ============================================================
// Hero → Content transition with ornament divider
// ============================================================
.hero-divider
  text-align: center
  padding: 0 0 var(--space-3xl)
  position: relative
  z-index: 1

// ============================================================
// LAYOUT — Section
// ============================================================
.section
  padding: var(--space-5xl) 0

  &__title
    font-size: var(--text-2xl)
    margin-bottom: var(--space-xl)

// ============================================================
// PAGE: Home — Magazine Grid
// ============================================================
.home-grid
  display: flex
  flex-direction: column
  gap: var(--space-xl)
  margin-top: var(--space-2xl)
  max-width: var(--content-width)
  margin-left: auto
  margin-right: auto
  width: 100%

  &__hero
    display: flex
    flex-direction: column
    gap: var(--space-xl)

    .card__excerpt
      -webkit-line-clamp: 3

  @media (max-width: 900px)
    gap: var(--space-lg)

    &__hero
      gap: var(--space-lg)

  @media (max-width: 640px)
    gap: var(--space-md)

    &__hero
      gap: var(--space-md)

// ============================================================
// COMPONENTS — Pagination
// ============================================================
.pagination
  display: flex
  justify-content: center
  align-items: center
  gap: var(--space-xs)
  margin-top: var(--space-4xl)
  font-family: var(--font-ui)

  .page-number
  .extend
    display: inline-flex
    align-items: center
    justify-content: center
    min-width: 2.5rem
    height: 2.5rem
    padding: 0 var(--space-sm)
    font-size: var(--text-sm)
    font-weight: 500
    color: var(--color-text-secondary)
    text-decoration: none
    border: 1px solid var(--color-border)
    border-radius: var(--radius-sm)
    transition: all var(--duration-fast) var(--ease-out)

    &.current
      background: var(--color-accent)
      color: var(--color-bg)
      border-color: var(--color-accent)

    &:hover:not(.current)
      border-color: var(--color-accent)
      color: var(--color-accent)

  .space
    display: inline-flex
    align-items: center
    justify-content: center
    min-width: 2.5rem
    height: 2.5rem
    color: var(--color-text-muted)
    font-size: var(--text-sm)

  .extend.prev
  .extend.next
    font-weight: 600
    letter-spacing: 0.02em

// ============================================================
// PAGE: Article (Post Detail)
// ============================================================
.article-header
  padding: var(--space-5xl) 0 var(--space-3xl)
  text-align: center

  &__date
    font-family: var(--font-ui)
    font-size: var(--text-sm)
    color: var(--color-text-muted)
    text-transform: uppercase
    letter-spacing: 0.06em
    margin-bottom: var(--space-sm)

  &__title
    font-size: var(--text-4xl)
    margin-bottom: var(--space-lg)

  &__meta
    display: flex
    justify-content: center
    gap: var(--space-md)
    flex-wrap: wrap

// Article featured image
.article-featured-image
  max-width: var(--content-wide)
  margin: 0 auto var(--space-4xl)
  padding: 0 var(--space-2xl)

  img
    width: 100%
    //height: clamp(240px, 40vh, 480px)
    object-fit: cover
    display: block
    border-radius: var(--radius-md)
    background: var(--color-surface)

  figcaption
    font-family: var(--font-ui)
    font-size: var(--text-xs)
    color: var(--color-text-muted)
    text-align: center
    margin-top: var(--space-sm)

// Article body
.article-body
  max-width: var(--content-width)
  margin: 0 auto
  padding: 0 var(--space-2xl) var(--space-5xl)

// Article layout with optional TOC sidebar
.article-layout
  display: grid
  grid-template-columns: 1fr
  max-width: var(--content-width)
  margin: 0 auto
  padding: 0 var(--space-2xl) var(--space-5xl)
  align-items: start

  .article-body
    max-width: none
    margin: 0
    padding: 0

    h2,h3,h4,h5,h6
      padding-top var(--space-xl)
     

  &--with-toc
    grid-template-columns: 180px 1fr 180px
    gap: var(--space-3xl)
    max-width: calc(var(--content-width) + 360px + var(--space-3xl) * 2)

  @media (max-width: 1024px)
    grid-template-columns: 1fr
    max-width: var(--content-width)

  @media (max-width: 1024px)
    &--with-toc
      grid-template-columns: 1fr

// Table of Contents sidebar
.toc-sidebar
  position: sticky
  top: var(--space-2xl)
  font-family: var(--font-ui)

  &::before
    content: ''
    display: block
    width: 2rem
    height: 1px
    background: var(--color-accent)
    margin-bottom: var(--space-md)

  &__title
    font-size: var(--text-xs)
    text-transform: uppercase
    letter-spacing: 0.08em
    color: var(--color-text-muted)
    margin-bottom: var(--space-sm)

  .toc
    list-style: decimal
    padding: 0
    padding-left: 1.25em
    font-size: var(--text-sm)

    .toc
      list-style: circle
      padding-left: 1.25em
      margin-top: var(--space-xs)
      font-size: inherit

  .toc-item
    margin-bottom: var(--space-4xs)

  .toc-link
    font-size: var(--text-sm)
    color: var(--color-text-secondary)
    text-decoration: none

    &:hover
      color: var(--color-accent)

  @media (max-width: 1024px)
    display: none

// Article Navigation (prev / next)
.article-nav
  display: grid
  grid-template-columns: 1fr 1fr
  gap: var(--space-xl)
  max-width: var(--content-width)
  margin: var(--space-5xl) auto 0
  padding: var(--space-3xl) 0 0
  border-top: 1px solid var(--color-border)

  &__item
    text-decoration: none
    padding: var(--space-lg)
    border: 1px solid var(--color-border)
    border-radius: var(--radius-md)
    transition: border-color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out)

    &:hover
      border-color: var(--color-accent)
      box-shadow: var(--shadow-card-hover)

    &--next
      text-align: right

  &__item:hover &__title
    color: var(--color-accent)

  &__label
    font-family: var(--font-ui)
    font-size: var(--text-xs)
    text-transform: uppercase
    letter-spacing: 0.08em
    color: var(--color-text-muted)
    margin-bottom: var(--space-xs)
    display: block

  &__title
    font-family: var(--font-display)
    font-size: var(--text-base)
    font-weight: 500
    color: var(--color-text-primary)
    transition: color var(--duration-fast) var(--ease-out)

  @media (max-width: 640px)
    grid-template-columns: 1fr

    &__item--next
      text-align: left

// ============================================================
// PAGE: About — Self Introduction
// ============================================================
.about-layout
  display: grid
  grid-template-columns: 280px 1fr
  gap: var(--space-4xl)
  align-items: start

  @media (max-width: 768px)
    grid-template-columns: 1fr

.about-sidebar
  text-align: center

.about-avatar
  width: 160px
  height: 160px
  border-radius: 50%
  object-fit: cover
  margin: 0 auto var(--space-lg)
  border: 3px solid var(--color-border)

.about-name
  font-size: var(--text-2xl)
  margin-bottom: var(--space-xs)

.about-role
  font-family: var(--font-ui)
  font-size: var(--text-sm)
  color: var(--color-text-muted)
  margin-bottom: var(--space-lg)

.about-social
  display: flex
  justify-content: center
  gap: var(--space-sm)
  list-style: none
  padding: 0

  a
    font-family: var(--font-ui)
    font-size: var(--text-sm)
    color: var(--color-text-secondary)

    &:hover
      color: var(--color-accent)

// Timeline
.timeline
  list-style: none
  margin-top: var(--space-sm)
  padding: 0
  position: relative

  &::before
    content: ''
    position: absolute
    left: 0
    top: 0
    bottom: 0
    width: 2px
    background: var(--color-border)

  &__item
    padding-left: var(--space-2xl)
    padding-bottom: var(--space-2xl)
    position: relative

    &::before
      content: ''
      position: absolute
      left: -5px
      top: 0.4em
      width: 12px
      height: 12px
      border-radius: 50%
      background: var(--color-accent)
      border: 2px solid var(--color-bg)

  &__year
    font-family: var(--font-ui)
    font-size: var(--text-xs)
    font-weight: 600
    color: var(--color-accent)
    text-transform: uppercase
    letter-spacing: 0.06em
    margin-bottom: var(--space-xs)

  &__title
    font-family: var(--font-display)
    font-size: var(--text-lg)
    font-weight: 500
    margin-bottom: var(--space-xs)

  &__desc
    font-size: var(--text-sm)
    color: var(--color-text-secondary)

// ============================================================
// PAGE: Archive
// ============================================================
.archive-year
  margin-bottom: var(--space-4xl)

  &__heading
    font-size: var(--text-2xl)
    color: var(--color-text-muted)
    padding-bottom: var(--space-sm)
    border-bottom: 1px solid var(--color-border)

.archive-list
  list-style: none
  padding: 0

  &__item
    display: flex
    gap: var(--space-lg)
    padding: var(--space-md) 0
    border-bottom: 1px solid var(--color-border)
    align-items: baseline

  &__date
    font-family: var(--font-mono)
    font-size: var(--text-sm)
    color: var(--color-text-muted)
    white-space: nowrap
    min-width: 5rem

  &__title
    font-family: var(--font-display)
    font-size: var(--text-base)
    font-weight: 500

    a
      color: var(--color-text-primary)

      &:hover
        color: var(--color-accent)

// ============================================================
// PAGE: Friends (友链)
// ============================================================
.friends-grid
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr))
  gap: var(--space-lg)

.friend-card
  display: flex
  align-items: center
  gap: var(--space-md)
  padding: var(--space-lg)
  background: var(--color-bg)
  border: 1px solid var(--color-border)
  border-radius: var(--radius-md)
  transition: transform var(--duration-normal) var(--ease-out),
              box-shadow var(--duration-normal) var(--ease-out)
  text-decoration: none

  &:hover
    transform: translateY(-4px)
    box-shadow: var(--shadow-card-hover)

  &__avatar
    width: 48px
    height: 48px
    border-radius: 50%
    object-fit: cover
    flex-shrink: 0
    background: var(--color-surface)

  &__name
    font-family: var(--font-display)
    font-size: var(--text-base)
    font-weight: 500
    color: var(--color-text-primary)
    margin-bottom: var(--space-4xs)

  &__desc
    font-family: var(--font-ui)
    font-size: var(--text-xs)
    color: var(--color-text-muted)

// ============================================================
// UTILITIES — Scroll Reveal
// ============================================================
.reveal
  opacity: 0
  transform: translateY(24px)
  transition: opacity var(--duration-slow) var(--ease-out),
              transform var(--duration-slow) var(--ease-out),
              box-shadow var(--duration-normal) var(--ease-out)

  &.visible
    opacity: 1
    transform: translateY(0)

a.card.reveal
  transition: opacity var(--duration-slow) var(--ease-out),
              transform var(--duration-normal) var(--ease-out),
              box-shadow var(--duration-normal) var(--ease-out)

// ============================================================
// UTILITIES — Skeleton / Loading Placeholder
// ============================================================
.skeleton
  background: linear-gradient(
    90deg,
    var(--color-surface) 25%,
    oklch(0.95 0.004 80) 50%,
    var(--color-surface) 75%
  )
  background-size: 200% 100%
  animation: shimmer 1.5s ease-in-out infinite
  border-radius: var(--radius-sm)

  @keyframes shimmer
    0%
      background-position: 200% 0
    100%
      background-position: -200% 0

// ============================================================
// UTILITIES — Back to Top
// ============================================================
.back-to-top
  position: fixed
  bottom: var(--space-2xl)
  right: var(--space-2xl)
  width: 44px
  height: 44px
  border-radius: 50%
  background: var(--color-bg)
  border: 1px solid var(--color-border)
  display: flex
  align-items: center
  justify-content: center
  cursor: pointer
  opacity: 0
  visibility: hidden
  transform: translateY(8px)
  transition: opacity var(--duration-normal) var(--ease-out),
              visibility var(--duration-normal) var(--ease-out),
              transform var(--duration-normal) var(--ease-out),
              box-shadow var(--duration-normal) var(--ease-out)
  z-index: 50
  font-size: var(--text-lg)
  color: var(--color-text-secondary)

  &.visible
    opacity: 1
    visibility: visible
    transform: translateY(0)

  &:hover
    box-shadow: var(--shadow-card-hover)
    color: var(--color-accent)

// ============================================================
// MEDIA — Print Styles
// ============================================================
@media print
  .site-nav
  .site-footer
  .back-to-top
    display: none

  body
    font-size: 12pt
    line-height: 1.6
    color: #000
    background: #fff

  a
    color: #000
    text-decoration: underline

  pre
    border: 1px solid #ccc
    background: #f9f9f9
    color: #000

// ============================================================
// DESIGN ELEMENTS PAGE — Specific Styles
// ============================================================
.elements-section
  padding: var(--space-3xl) 0

  &__heading
    font-size: var(--text-2xl)
    margin-bottom: var(--space-2xl)
    padding-bottom: var(--space-md)
    border-bottom: 2px solid var(--color-border-strong)

.elements-subsection
  margin-bottom: var(--space-3xl)

  &__title
    font-family: var(--font-ui)
    font-size: var(--text-sm)
    text-transform: uppercase
    letter-spacing: 0.08em
    color: var(--color-text-muted)
    margin-bottom: var(--space-lg)

// Color swatches
.color-grid
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr))
  gap: var(--space-md)

.color-swatch
  border: 1px solid var(--color-border)
  border-radius: var(--radius-md)
  overflow: hidden

  &__preview
    height: 80px

  &__info
    padding: var(--space-sm) var(--space-md)
    background: var(--color-bg)

  &__name
    font-family: var(--font-mono)
    font-size: var(--text-xs)
    font-weight: 600
    color: var(--color-text-primary)
    margin-bottom: var(--space-4xs)

  &__value
    font-family: var(--font-mono)
    font-size: var(--text-xs)
    color: var(--color-text-muted)

// Typography sample
.type-sample
  margin-bottom: var(--space-2xl)
  padding: var(--space-lg)
  border: 1px solid var(--color-border)
  border-radius: var(--radius-md)
  background: var(--color-bg)

  &__label
    font-family: var(--font-mono)
    font-size: var(--text-xs)
    color: var(--color-text-muted)
    margin-bottom: var(--space-sm)
    text-transform: uppercase
    letter-spacing: 0.06em

// Spacing scale
.space-row
  display: flex
  align-items: center
  gap: var(--space-md)
  margin-bottom: var(--space-sm)

  &__bar
    height: 8px
    background: var(--color-accent)
    border-radius: 2px

  &__label
    font-family: var(--font-mono)
    font-size: var(--text-xs)
    color: var(--color-text-muted)
    min-width: 80px

// Components row display
.components-row
  display: flex
  flex-wrap: wrap
  gap: var(--space-md)
  align-items: center

// ============================================================
// PAGE: Tags — Tag Cloud
// ============================================================
.tag-cloud
  display: flex
  flex-wrap: wrap
  gap: var(--space-sm)
  justify-content: center
  padding: var(--space-2xl) 0

  &__item
    display: inline-flex
    align-items: center
    gap: var(--space-4xs)
    text-decoration: none
    transition: transform var(--duration-fast) var(--ease-out)

    &:hover
      transform: scale(1.08)

    .tag
      font-size: inherit

  &__count
    font-family: var(--font-mono)
    color: var(--color-text-muted)
    font-size: 0.7em
    font-weight: 400

// ============================================================
// PAGE: Categories — Category List
// ============================================================
.category-section
  margin-bottom: var(--space-4xl)

  &__heading
    font-size: var(--text-2xl)
    font-weight: 500
    padding-bottom: var(--space-sm)
    border-bottom: 1px solid var(--color-border)
    display: flex
    align-items: baseline
    gap: var(--space-sm)
    margin-bottom: var(--space-lg)

    a
      color: var(--color-text-primary)
      text-decoration: none

      &:hover
        color: var(--color-accent)

  &__count
    font-family: var(--font-mono)
    font-size: var(--text-sm)
    color: var(--color-text-muted)
    font-weight: 400

.category-posts
  list-style: none
  padding: 0

  &__item
    display: flex
    gap: var(--space-lg)
    padding: var(--space-sm) 0
    border-bottom: 1px solid var(--color-border)
    align-items: baseline

    a
      font-family: var(--font-display)
      font-size: var(--text-base)
      font-weight: 500
      color: var(--color-text-primary)

      &:hover
        color: var(--color-accent)

  &__date
    font-family: var(--font-mono)
    font-size: var(--text-sm)
    color: var(--color-text-muted)
    white-space: nowrap
    min-width: 6rem